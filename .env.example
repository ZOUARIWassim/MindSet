# Copy this file to .env and update the values for local development

# Postgres connection string used by Prisma (see docker-compose.yml for local dev)
DATABASE_URL="postgresql://mindset:mindset@localhost:5432/mindset"

# Auth.js session secret (generate with: openssl rand -hex 32)
AUTH_SECRET=

# Verifies requests to /api/cron/insights are actually from Vercel Cron.
# Optional locally - the route skips the check when unset.
CRON_SECRET=

NODE_ENV=development
